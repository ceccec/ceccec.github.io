{
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "devDependencies": {
    "shadcn-vue": "^2.7.4",
    "vitepress": "2.0.0-alpha.17",
    "vue": "^3.5.38"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "docs:build": "export NODE_COMPILE_CACHE=node_modules/.cache/ts && export NODE_OPTIONS=--max-old-space-size=8192 && vitepress build && node --experimental-strip-types scripts/enforcement-trinity.mjs",
    "docs:preview": "vitepress preview",
    "cf:wizard": "node --experimental-strip-types scripts/generate-cloudflare.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.6.0"
  }
}
