/-
  FEELING — FEELING, THOUGHT AND EMOTION AS A TRINITY, AND VALENCE AS THE FLIP ACROSS IT.

  The model, as the page /feeling draws it:

    feeling   the body's signal — raw affect, pleasant or unpleasant, before any story
    thought   the reading — appraisal: what is this, is it about me, can I handle it (Lazarus, Scherer)
    emotion   the episode — signal and reading fused into something with a name and a push (Barrett)

  They run in a loop: feeling feeds thought, thought shapes emotion, emotion changes the body, which is
  new feeling. That loop is a ROTATION of three corners, and valence (pleasant ↔ unpleasant) is a FLIP
  that acts on every corner at once. This file proves what that model is, as algebra:

    the turn returns in three steps and fixes no corner          ρ³ = id, ρ c ≠ c
    turning back is two turns forward                            ρ⁻¹ = ρ²
    the flip returns in two steps                                σ² = id
    the flip commutes with the turn                              ρσ = σρ
    so the six symmetries form ONE CYCLIC GROUP of order six     ℤ₃ × ℤ₂ ≅ ℤ₆, generated by ρσ
    with exactly one pure flip, two turns and two flip-turns     orders 2, 3, 3, 6, 6
    and it is NOT the dihedral group of the triangle             no element reverses the turn

  A first description of this model said "three turns and three flips". That is the dihedral group,
  where a flip reverses the turn; here the flip commutes with it, and the theorems below count the
  elements of order two and find exactly one.

  WHAT THIS DOES NOT PROVE: that experience divides into exactly these three, that the loop runs in
  this order, or that mixed states (bittersweet, anxious excitement) fit a single valence axis — there
  is evidence they do not. Those are empirical questions about minds. This file proves the algebra of
  the model, and nothing about whether the model is a mind.
-/

namespace Feeling

inductive Corner where
  | feeling | thought | emotion
  deriving DecidableEq, Repr

inductive Valence where
  | pleasant | unpleasant
  deriving DecidableEq, Repr

open Corner Valence

def corners : List Corner := [feeling, thought, emotion]

/-- The forward turn: feeling feeds thought, thought shapes emotion, emotion changes the body. -/
def turn : Corner → Corner
  | feeling => thought
  | thought => emotion
  | emotion => feeling

/-- The backward turn: a thought starts a feeling, an emotion revises a thought. -/
def back : Corner → Corner
  | feeling => emotion
  | thought => feeling
  | emotion => thought

def flip : Valence → Valence
  | pleasant => unpleasant
  | unpleasant => pleasant

/-- A state of the model: where in the loop, and with which valence. -/
structure State where
  corner : Corner
  valence : Valence
  deriving DecidableEq, Repr

def states : List State :=
  [⟨feeling, pleasant⟩, ⟨thought, pleasant⟩, ⟨emotion, pleasant⟩,
   ⟨feeling, unpleasant⟩, ⟨thought, unpleasant⟩, ⟨emotion, unpleasant⟩]

def ρ (s : State) : State := ⟨turn s.corner, s.valence⟩
def σ (s : State) : State := ⟨s.corner, flip s.valence⟩


/-- f applied k times. -/
def pow (f : State → State) : Nat → State → State
  | 0, s => s
  | k + 1, s => f (pow f k s)

/-- The symmetry (i, j): flip j times, then turn i times. -/
def act (i j : Nat) (s : State) : State := pow ρ i (pow σ j s)

/-- The six symmetries as (turns, flips). -/
def symmetries : List (Nat × Nat) := [(0, 0), (1, 0), (2, 0), (0, 1), (1, 1), (2, 1)]

/-- Two symmetries are equal when they agree on every state. -/
def same (f g : State → State) : Bool := states.all (fun s => f s == g s)


/-- The order of a symmetry: the least k ≥ 1 with f^k = id, searched up to six. -/
def order (f : State → State) : Nat :=
  ([1, 2, 3, 4, 5, 6].find? (fun k => same (pow f k) id)).getD 0

/-! ## The trinity -/

theorem the_state_space_has_six_states : states.length = 6 ∧ states.Nodup := by decide

theorem three_turns_return : ∀ c ∈ corners, turn (turn (turn c)) = c := by decide

theorem no_corner_is_fixed : ∀ c ∈ corners, turn c ≠ c := by decide

theorem turning_back_undoes_the_turn : ∀ c ∈ corners, back (turn c) = c ∧ turn (back c) = c := by decide

theorem turning_back_is_two_turns_forward : ∀ c ∈ corners, back c = turn (turn c) := by decide

/-! ## Valence -/

theorem the_flip_returns_in_two : ∀ v ∈ [pleasant, unpleasant], flip (flip v) = v := by decide

theorem the_flip_fixes_no_valence : ∀ v ∈ [pleasant, unpleasant], flip v ≠ v := by decide

theorem the_flip_commutes_with_the_turn : ∀ s ∈ states, ρ (σ s) = σ (ρ s) := by decide

/-! ## The group they make -/

/-- The six symmetries are six different maps. -/
theorem the_six_symmetries_are_distinct :
    ∀ a ∈ symmetries, ∀ b ∈ symmetries, a ≠ b → same (act a.1 a.2) (act b.1 b.2) = false := by decide

/-- Their orders, in the order (0,0), (1,0), (2,0), (0,1), (1,1), (2,1). -/
theorem the_orders_are_one_three_three_two_six_six :
    symmetries.map (fun a => order (act a.1 a.2)) = [1, 3, 3, 2, 6, 6] := by decide

/-- Exactly one symmetry other than the identity undoes itself: the pure flip. -/
theorem exactly_one_pure_flip :
    symmetries.filter (fun a => order (act a.1 a.2) == 2) = [(0, 1)] := by decide

/-- One flip-and-turn reaches every symmetry: the group is cyclic, generated by ρσ. -/
theorem the_group_is_cyclic_generated_by_flip_and_turn :
    order (act 1 1) = 6 ∧
    ∀ a ∈ symmetries, [0, 1, 2, 3, 4, 5].any (fun k => same (pow (act 1 1) k) (act a.1 a.2)) := by decide

/-- The turn backward, on states. -/
def ρback (s : State) : State := ⟨back s.corner, s.valence⟩

/-- Every symmetry τ commutes with the turn, so τ ρ τ⁻¹ = ρ — and ρ is not its own reverse. In the triangle's
    dihedral group a reflection τ gives τ ρ τ⁻¹ = ρ⁻¹; here no symmetry does, so this is not that group. -/
theorem not_the_dihedral_group :
    (∀ a ∈ symmetries, same (fun s => act a.1 a.2 (ρ s)) (fun s => ρ (act a.1 a.2 s)) = true) ∧
    same ρ ρback = false := by decide

end Feeling
