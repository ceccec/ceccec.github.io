/-
  MOVIE — every number the background movie paints with that no other theorem decides, defined here and decided.

  The movie is the double torus in motion (owner, 2026-11-15: "find their theorems and let them decide lean"). Its angles
  are decided in quantum.lean. Its radii, alphas, lightnesses, rates, colour stops and breakpoints were literals in the
  painters; each is now a definition in this file, and verify:movie refuses a painter whose number differs from it.

  WHAT IS DECIDED, AND WHAT IS NOT. The kernel decides the law each number must keep: a colour stop lies in [0, 1] (the
  Canvas API throws outside it), an alpha is a visible fraction no greater than one, a lightness lies strictly between
  black and white, a Fibonacci index falls inside the table it indexes, the void is ONE radius in every painter that
  draws it, the width breakpoints rise, a whole number is whole. It does NOT decide that 7/100 is the only possible
  void: other values keep the same laws. Where a law admits several values, this file records which one was chosen.
-/

set_option maxRecDepth 100000

namespace Movie

/-- A rational as a sign, a numerator and a denominator, so every law decides over Nat and rests on no axiom. -/
structure Q where
  neg : Bool
  n : Nat
  d : Nat
deriving DecidableEq, Repr

/-- a < b, cross-multiplied, for the non-negative values the laws compare. -/
def Q.lt (a b : Q) : Bool := !a.neg && !b.neg && a.n * b.d < b.n * a.d
def Q.le (a b : Q) : Bool := !a.neg && !b.neg && a.n * b.d ≤ b.n * a.d
def Q.positive (a : Q) : Bool := !a.neg && 0 < a.n && 0 < a.d
def Q.same (a b : Q) : Bool := a.neg == b.neg && a.n * b.d == b.n * a.d

