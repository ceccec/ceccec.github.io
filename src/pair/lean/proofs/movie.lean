/-- A colour stop outside [0, 1] makes addColorStop throw IndexSizeError (HTML Canvas). -/
theorem every_colour_stop_lies_in_the_unit_interval :
  colourStops.all (fun s => !s.neg && s.n ≤ s.d && 0 < s.d) := by decide +kernel

/-- An alpha is positive (else the layer is invisible) and at most one (Canvas clamps above). -/
theorem every_alpha_is_a_visible_fraction :
  alphas.all (fun a => a.positive && a.n ≤ a.d) := by decide +kernel

/-- A lightness of 0 is black and 1 is white; the movie paints neither as a colour. -/
theorem every_lightness_is_between_black_and_white :
  lightnesses.all (fun l => l.positive && l.n < l.d) := by decide +kernel

/-- FIBONACCI has 32 terms; an index past them reads undefined. -/
theorem every_fibonacci_index_falls_inside_the_table :
  fibonacciIndices.all (fun i => !i.neg && i.d == 1 && i.n < 32) := by decide +kernel

/-- Three painters draw the void; they draw the same one. -/
theorem the_void_is_one_radius_in_every_painter :
  voids.length = 3 ∧ voids.all (fun v => v.same paintHolographicPlasmaHeroMovie_voidR && v.positive) := by decide +kernel

/-- The depth steps up past 520 and 900 pixels, the arm bonus past 480 and 800; each pair rises. -/
theorem the_width_breakpoints_rise :
  drawHero_when2.lt drawHero_when ∧ drawHero_when4.lt drawHero_when3 ∧ drawHero_when4.lt drawHero_when := by decide +kernel

/-- Counts, slice bounds and radices are positive whole numbers. -/
theorem every_count_and_index_is_whole :
  wholes.all (fun w => !w.neg && w.d == 1 && 0 < w.n) := by decide +kernel

/-- The negative values are counter-spins and negative powers of φ; none is a signed zero. -/
theorem every_negative_value_is_nonzero :
  negatives.all (fun v => v.neg && 0 < v.n && 0 < v.d) := by decide +kernel

/-- Rates, radii, widths and offsets are positive; a zero freezes or hides a layer. The weakest law here: it rules out zero and sign, not size. -/
theorem every_rate_radius_and_width_is_positive :
  positives.all Q.positive := by decide +kernel

end Movie
