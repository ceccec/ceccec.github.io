# Local live trading — copy to `.env` and fill optional keys only.
# Keyless feeds (no .env required): coinbase, binance, kraken, bitstamp, hyperliquid.
# Uniswap has no public OHLC — mocked when selected.
# Alpaca and Polygon.io require keys below.

# NODE_OPTIONS=--max-old-space-size=2048  # canonical 2GB heap cap (also enforced in scripts/docs-build.mjs + docs:dev)
# QUANTUM_TIMEOUT_MS=120000  # build/generic default 120000, max 180000
# TRADING_TIMEOUT_MS=60000   # trading default 30000 offline / 60000 live, max 120000
# REALTIME_ACK_MS=45000      # instruction ack/heartbeat window; unresponsive → SIGKILL exit 137; max 60000

# Platform id from tradingPlatforms() — default coinbase
TRADING_PLATFORM=coinbase

# Optional — Alpaca equities bars (SPY)
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_DATA_URL=https://data.alpaca.markets

# Optional — Polygon.io multi-asset bars
# POLYGON_API_KEY=
