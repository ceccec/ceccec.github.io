**/node_modules/**
**/.vitepress/dist/**
**/.vitepress/cache/**
**/.vitepress/.temp/**
**/.vitepress/.build-lock

# OS cruft
**/.DS_Store

# Repo-root temp codemod scripts (AGENTS.md fold/cleanup orphans — regenerable, never source).
/.tmp-*

# Local secrets — never commit; see .env.example
.env

# Machine-local Claude Code permissions (repo workflows and CLAUDE.md are tracked).
/.claude/settings.local.json

# Generated Bible-in-Glagolitic artifacts (scripts/generate-bible-glagolitic.mjs) — regenerable, not source.
/bible.glagolitic.txt
/bible.parallel.json

# Generated dist artifacts may land in public/ at build time (llms.txt, etc.).

# @ceccec/double-torus kernel build output (rebuilt by the publish workflow)
/packages/kernel/

# Publication artifacts (not source code)
/docs